%% Level 2 — System Overview of Quirón Digital Operating System
%% Purpose: one glance shows the six layers and the one legal path into the Spine.
%% Each layer is detailed in its own file — see the sibling .mmd files in this folder:
%%   01-core-spine-detail.mmd        — what lives inside the Spine + the 5 Core Contracts
%%   02-event-flow.mmd               — publish -> Event Backbone -> subscribers example
%%   03-business-branches.mmd        — Quirón Seguros vs Arquitectos Financieros / BP routing
%%   04-architectural-boundary.mmd   — inside vs outside the Spine
%% The existing Figma blueprint remains the authoritative Level-3 Core / Spine detail.
%% Principle: Spine coordinates; domains own operational data; everything goes through Core Contracts.

flowchart TB

    AI["AI / AUTOMATION\n(AI Agents, Workflow Automation)"]
    DOMAINS["BUSINESS DOMAINS\n(Clientes, Pólizas, Siniestros, Renovaciones,\nPagos, Ventas, Marketing, BP — own their data)"]
    SHARED["SHARED OPERATIONAL SERVICES\n(Messaging, Identity, Documents, Tasks, Notifications)"]
    CONTRACTS["CORE CONTRACTS / INTERFACE\n(only legal path into the Spine)"]
    SPINE(["CORE / SPINE\n'coordinates the system, does not become the system'"])
    EXTERNAL["EXTERNAL SYSTEMS / INTEGRATIONS\n(WhatsApp, Gmail, Drive, Carrier APIs, ...)"]

    AI -- uses --> CONTRACTS
    DOMAINS -- uses --> CONTRACTS
    SHARED -- uses --> CONTRACTS
    CONTRACTS -- lookup / publish / subscribe --> SPINE
    EXTERNAL -- enters through --> SHARED

    classDef spine fill:#0b2545,stroke:#0b2545,color:#ffffff,stroke-width:2px;
    classDef contracts fill:#0f766e,stroke:#0f766e,color:#ffffff;
    classDef domains fill:#e5e7eb,stroke:#6b7280,color:#111827;
    classDef shared fill:#dcfce7,stroke:#16a34a,color:#14532d;
    classDef ai fill:#ede9fe,stroke:#7c3aed,color:#3b0764;
    classDef external fill:#f3f4f6,stroke:#9ca3af,color:#374151,stroke-dasharray: 3 3;

    class SPINE spine
    class CONTRACTS contracts
    class DOMAINS domains
    class SHARED shared
    class AI ai
    class EXTERNAL external
