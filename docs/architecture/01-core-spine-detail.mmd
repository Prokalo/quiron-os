%% Detail view — what lives inside the Core / Spine, and the 5 Core Contracts that guard it.
%% Companion to 00-quiron-system-architecture.mmd (the CONTRACTS -> SPINE edge, expanded).
%% No domain, service, or AI agent may reach these internals directly — only through the contracts below.

flowchart TB

    subgraph CONTRACTS["CORE CONTRACTS / INTERFACE (only legal path in)"]
        direction LR
        EntityLookup["Entity Lookup"]
        RelLookup["Relationship Lookup"]
        EventPublish["Event Publish"]
        EventSubscribe["Event Subscribe"]
        MetaLookup["Metadata Lookup"]
    end

    subgraph SPINE["CORE / SPINE — 'coordinates the system, does not become the system'"]
        direction TB
        CanonicalIDs["Canonical IDs:\nClienteID · PolizaID · SiniestroID"]
        RelRegistry["Relationship Registry (examples):\nCliente owns Poliza · Poliza has Siniestro\nCliente assigned_to Asesor · Cliente belongs_to Business Branch\nCliente classified_as Segment · Poliza issued_by Carrier\nPoliza belongs_to Product"]
        EventBackbone(["Live Board / Event Backbone\n(single async communication bus)"])
        SharedMeta["Shared Metadata references:\nBusiness Branches · Segments · Carriers\nProducts/Plans · Statuses · Calendars\nSLAs · Regions · Channels · Classifications"]
    end

    EntityLookup -- lookup --> CanonicalIDs
    RelLookup -- lookup --> RelRegistry
    EventPublish -- publish --> EventBackbone
    EventSubscribe -- subscribe --> EventBackbone
    MetaLookup -- lookup --> SharedMeta

    classDef spine fill:#0b2545,stroke:#0b2545,color:#ffffff,stroke-width:2px;
    classDef contracts fill:#0f766e,stroke:#0f766e,color:#ffffff;

    class CanonicalIDs,RelRegistry,EventBackbone,SharedMeta spine
    class EntityLookup,RelLookup,EventPublish,EventSubscribe,MetaLookup contracts
