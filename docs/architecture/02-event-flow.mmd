%% Detail view — how one domain announces something happened and others react.
%% Rule: never draw a direct arrow between two domains/services.
%% Always: Source -> publish -> Event Backbone -> distribute -> Subscribers.

flowchart TB

    Polizas["Pólizas (source domain)"]
    EventBackbone(["Live Board / Event Backbone"])
    Documents["Documents"]
    Messaging["Messaging"]
    Clientes["Clientes / Cliente 360"]
    Renovaciones["Renovaciones"]

    Polizas -. "publish: PolicyIssued" .-> EventBackbone
    EventBackbone -. distribute .-> Documents
    EventBackbone -. distribute .-> Messaging
    EventBackbone -. distribute .-> Clientes
    EventBackbone -. distribute .-> Renovaciones

    classDef spine fill:#0b2545,stroke:#0b2545,color:#ffffff,stroke-width:2px;
    classDef domains fill:#e5e7eb,stroke:#6b7280,color:#111827;
    classDef shared fill:#dcfce7,stroke:#16a34a,color:#14532d;

    class EventBackbone spine
    class Polizas,Clientes,Renovaciones domains
    class Documents,Messaging shared
