flowchart TB
    subgraph CORE["Core / Spine - owns no domain data"]
        direction LR
        ID["Registro de Identidad<br/>ClientID - PolizaID - SiniestroID<br/>(canonical, PII-free)"]
        REL["Relaciones<br/>Client to Poliza (1:N)<br/>Poliza to Siniestro (1:N)"]
        BUS(["Event Backbone<br/>'Live Board'<br/>(Postgres events table)"])
        ENT["Entity Registry<br/>Estado Compartido<br/>(lifecycle - owner - team)"]
    end

    subgraph DOMAINS["Dominios de Negocio"]
        direction TB
        MKT["Marketing y Leads<br/>(Ambos)"]
        VEN["Ventas<br/>(Ambos)"]
        POL["Polizas<br/>(Seguros)"]
        SIN["Siniestros<br/>(Seguros)"]
        REN["Renovaciones<br/>(Seguros)"]
        PAG["Pagos<br/>(Seguros)"]
    end

    subgraph SHARED["Servicios Compartidos"]
        direction TB
        CLI["Clientes / Cliente 360"]
        TAR["Tareas / Agendas"]
        DOC["Documentos"]
    end

    subgraph GAP["Open gap"]
        BP["Proyectos BP / Fideicomisos<br/>(no domain defined yet -<br/>priority #1 before BP backend)"]
    end

    subgraph MSG["Messaging Module - v1 build target"]
        direction TB
        THR["Threads / Conversaciones<br/>(bot to human handoff)"]
        AUTO["Automation Rules<br/>('el robot')"]
        INBOX["Advisor Inbox"]
        subgraph ADAPTERS["Channel Adapters (pluggable)"]
            direction LR
            WA["WhatsApp<br/>(real)"]
            EM["Email<br/>(real)"]
            MOCK["MockAdapter<br/>(dev/test)"]
        end
    end

    MKT <-->|publish/consume| BUS
    VEN <-->|publish/consume| BUS
    POL <-->|publish/consume| BUS
    SIN <-->|publish/consume| BUS
    REN <-->|publish/consume| BUS
    PAG <-->|publish/consume| BUS

    CLI <-->|publish/consume| BUS
    TAR <-->|publish/consume| BUS
    DOC <-->|publish/consume| BUS

    BP -.->|not yet wired| BUS

    THR -->|message.sent / message.received| BUS
    AUTO -->|handoff.requested| BUS
    BUS -->|lead.created, cobro.rechazado, etc. trigger| AUTO
    THR -.->|resolve channel handle to party| ID

    WA --> THR
    EM --> THR
    MOCK --> THR
    THR --> INBOX

    ID --- REL
    REL --- BUS
    BUS --- ENT

    classDef core fill:#2b2d42,color:#fff,stroke:#2b2d42
    classDef domain fill:#8d99ae,color:#fff,stroke:#8d99ae
    classDef shared fill:#5c8374,color:#fff,stroke:#5c8374
    classDef msg fill:#457b9d,color:#fff,stroke:#457b9d
    classDef gap fill:#e76f51,color:#fff,stroke:#e76f51,stroke-dasharray: 5 5

    class ID,REL,BUS,ENT core
    class MKT,VEN,POL,SIN,REN,PAG domain
    class CLI,TAR,DOC shared
    class THR,AUTO,INBOX,WA,EM,MOCK msg
    class BP gap