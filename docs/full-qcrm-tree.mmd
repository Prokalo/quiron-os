classDef root fill:#202533,color:#fff,stroke:#202533,stroke-width:2px
classDef spine fill:#343b52,color:#fff,stroke:#343b52
classDef group fill:#eef2f7,color:#172033,stroke:#aeb7c5,stroke-width:1.5px
classDef seguros fill:#dbe7f5,color:#173b63,stroke:#7393b9
classDef bp fill:#f3eadc,color:#5f4527,stroke:#b4946b
classDef shared fill:#e0eee8,color:#244c3d,stroke:#7aa090
classDef msg fill:#e2edf4,color:#24485f,stroke:#7b9caf
classDef bridge fill:#f4d6b4,color:#6a3d12,stroke:#c47a30,stroke-width:3px
classDef pending fill:#ffffff,color:#5f4527,stroke:#b4946b,stroke-width:2px,stroke-dasharray:4 3
classDef leaf fill:#ffffff,color:#202533,stroke:#c8cfd9

class CORE root
class ID,REL,BUS,ENT,RULE spine
class BUSINESS group
class SEG,S1,S2,S3,S4,SIM,SSEG seguros
class BP,B1,B2,B3,B4,B5,B6 bp
class SHARED,CLI,TAR,DOC,CLISVC,CH,PT shared
class MSG,AUTO,THR,INBOX,ADAPT,WA,EM,MOCK,PADP msg
class B34,S26 bridge
class B5,B5A,B5B,B5C,B6F pending

%% Most detailed leaf nodes stay neutral for readability.
class S11,S12,S13,S14,S15,S16,S21,S22,S23,S24,S25,S27,S28,S29,S210,S211,S212,SIND,SEMP,SASEG,S31,S31A,S31B,S31C,S31D,S32,S32A,S32B,S32C,S32D,S33,S33A,S33B,S33C,S33D,S33E,S33F,S41,S41A,S41B,S41C,S41D,S42,S42A,S42B,S42C,S42D,S43,S43A,S43B,S43C,S44,S44A,S44B,SIM1,SIM2,SIM3 leaf
class B11,B12,B13,B14,B15,B16,B21,B22,B23,B24,B25,B31,B31A,B32,B32A,B33,B33A,H1,H2,H3,H4,B35,B35A,B36,B36A,B37,B37A,B38,B38A,B39,B39A,B310,B310A,B41,B42,B43,B44,B45,B46,B47,B6A,B6B,B6C,B6D,B6E,CLI1,CLI2,TAR1,DOC1,CH1,CH2,CH3,CH4,CH5,CH6,CH7,PT1,PT2,PT3,PT4,PT5,PT6,PT7 leaf