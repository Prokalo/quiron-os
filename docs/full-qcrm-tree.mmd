flowchart TB

%% =========================================================
%% QUIRÓN OS / QCRM — DETAILED TREE ARCHITECTURE (v2)
%% Goal: preserve detail while keeping a readable top-down hierarchy.
%% Main rule: parent-child tree first; only essential cross-links are shown.
%% Los números ①–⑩ son el orden de construcción.
%% Cruces entre dominios: SIEMPRE por eventos vía Event Backbone (líneas punteadas).
%% =========================================================

CORE["① CORE / SPINE"]

%% -------------------------
%% CORE / SPINE INTERNALS
%% -------------------------
CORE --> ID["Registro de Identidad<br/>ClientID · PolizaID · SiniestroID · ProyectoBPID<br/>(canonical / PII-free)"]
CORE --> REL["Relaciones<br/>Cliente → Póliza<br/>Póliza → Siniestro<br/>Cliente → Proyecto BP"]
CORE --> BUS(["Event Backbone / Live Board<br/>Postgres events table<br/>los dominios nunca se llaman entre sí"])
CORE --> ENT["Entity Registry<br/>Estado compartido<br/>lifecycle · owner · team"]
CORE --> RULE["Regla de clasificación<br/>ClientClassification = BP → BusinessLine = AF"]

%% The Event Backbone is the trunk that connects the system branches.
BUS --> SHARED["② SERVICIOS COMPARTIDOS"]
BUS --> MSG["③ MESSAGING"]
BUS --> BUSINESS["DOMINIOS DE NEGOCIO"]
BUS --> CLISVC["⑦ SERVICIOS DE CLIENTE COMPARTIDOS<br/>ambas líneas · se construyen una sola vez"]

%% =========================================================
%% BUSINESS TREE
%% =========================================================
BUSINESS --> SEG["QUIRÓN SEGUROS"]
BUSINESS --> BP["QUIRÓN ARQUITECTOS FINANCIEROS / BP"]

%% ---------------------------------------------------------
%% QUIRÓN SEGUROS
%% ---------------------------------------------------------
SEG --> S1["④ 1. PROSPECCIÓN Y MARKETING"]
SEG --> S2["⑤ 2. VENTA / PROCESO COMERCIAL"]
SEG --> S3["⑥ 3. OPERACIONES / SERVICIO AL CLIENTE"]
SEG --> S4["⑦ 4. ADMINISTRACIÓN SEGUROS<br/>dominio propio de la línea"]
SEG --> SIM["⑦ INTELIGENCIA DE MERCADO<br/>Y ANÁLISIS POR CLIENTE"]

%% Seguros 1
S1 --> S11["1.1 Estrategia y planeación de marketing"]
S1 --> S12["1.2 Segmentación de audiencias<br/>Individual / Empresarial"]
S1 --> S13["1.3 Creación de contenido<br/>educativo y comercial"]
S1 --> S14["1.4 Ejecución de campañas<br/>multicanal"]
S1 --> S15["1.5 Generación de leads<br/>fuente: embajador → guarda AmbassadorID"]
S1 --> S16["1.6 Medición y optimización"]

%% Seguros 2
S2 --> S21["2.1 Recepción de lead"]
S2 --> S22["2.2 Atención inicial"]
S2 --> S23["2.3 Calificación del lead<br/>segmento · ramo · aseguradora"]
S2 --> S24["2.4 Seguimiento y nutrición"]
S2 --> S25["2.5 Primera entrevista<br/>llamada con asesor"]
S2 --> S26["2.6 Presentación de propuesta<br/>comparativo multiaseguradoras<br/>(también entrada de oportunidades BP)"]
S2 --> S27["2.7 Solicitud y cierre"]
S2 --> S28["2.8 En emisión"]
S2 --> S29["2.9 Póliza emitida"]
S2 --> S210["2.10 Entrega de póliza"]
S2 --> S211["2.11 Póliza emitida cobrada"]
S2 --> S212["2.12 Cliente activo"]

%% Seguros segments / products
S2 --> SSEG["SEGMENTOS Y RAMOS"]
SSEG --> SIND["Individual<br/>Vida · GMM · Autos · Daños"]
SSEG --> SEMP["Empresarial<br/>Vida Grupo · GMM Grupo · Flotillas · Daños Empresariales"]
SSEG --> SASEG["Aseguradoras<br/>GNP · MetLife · AXA · Quálitas · otras"]

%% Seguros 3 (Customer Happiness ya no vive aquí: es compartido)
S3 --> S31["3.1 Renovaciones"]
S31 --> S31A["Próximas renovaciones"]
S31 --> S31B["Revisión de necesidades"]
S31 --> S31C["Cotizaciones multiaseguradoras"]
S31 --> S31D["Gestión / emisión / confirmación"]

S3 --> S32["3.2 Siniestros"]
S32 --> S32A["Reporte del siniestro"]
S32 --> S32B["Orientación y validación de información"]
S32 --> S32C["Gestión con aseguradora"]
S32 --> S32D["Seguimiento · resolución · cierre"]

S3 --> S33["3.3 Postventa"]
S33 --> S33A["Dudas y solicitudes"]
S33 --> S33B["Cambios en póliza"]
S33 --> S33C["Gestión de pagos"]
S33 --> S33D["Actualización de datos"]
S33 --> S33E["Cross-selling / upselling"]
S33 --> S33F["Comunicación preventiva"]

%% Seguros 4
S4 --> S41["4.1 Ingresos y contabilidad"]
S41 --> S41A["Ingresos por aseguradora"]
S41 --> S41B["Control de cobranza"]
S41 --> S41C["Conciliaciones"]
S41 --> S41D["Gestión contable"]

S4 --> S42["4.2 Estados de resultados"]
S42 --> S42A["Por ramo"]
S42 --> S42B["Por aseguradora"]
S42 --> S42C["Por segmento"]
S42 --> S42D["Rentabilidad"]

S4 --> S43["4.3 KPIs y métricas"]
S43 --> S43A["Ventas · conversión · renovaciones"]
S43 --> S43B["Siniestros · satisfacción"]
S43 --> S43C["Producción por aseguradora"]

S4 --> S44["4.4 Reportes"]
S44 --> S44A["Operativos · financieros · comerciales"]
S44 --> S44B["Personalizados · exportación de datos"]

%% Seguros intelligence
SIM --> SIM1["Análisis del entorno<br/>tendencias · competencia · oportunidades"]
SIM --> SIM2["Análisis por cliente<br/>perfil · necesidades · crecimiento"]
SIM --> SIM3["Dashboards y reportes<br/>tiempo real · segmentación · recomendaciones"]

%% ---------------------------------------------------------
%% ARQUITECTOS FINANCIEROS / BP
%% ---------------------------------------------------------
BP --> B1["⑧ 1. POSICIONAMIENTO Y MARKETING"]
BP --> B2["⑧ 2. VENTA"]
BP --> B3["⑨ 3. DESARROLLO DEL PROYECTO"]
BP --> B4["⑩ 4. INTELIGENCIA DE MERCADO<br/>Y ANÁLISIS POR CLIENTE"]
BP --> B5["⑩ 5. OPERACIONES BP<br/>por definir"]
BP --> B6["⑩ 6. ADMINISTRACIÓN BP<br/>dominio propio · provisional"]

%% BP 1
B1 --> B11["1.1 Estrategia de comunicación"]
B1 --> B12["1.2 Creación de contenido de valor"]
B1 --> B13["1.3 Difusión en canales estratégicos"]
B1 --> B14["1.4 Generación de prospectos<br/>fuente: embajador → guarda AmbassadorID"]
B1 --> B15["1.5 Relacionamiento y networking"]
B1 --> B16["1.6 Medición y optimización"]

%% BP 2
B2 --> B21["2.1 Cita inicial<br/>conocer necesidades"]
B2 --> B22["2.2 NDA<br/>protección de información"]
B2 --> B23["2.3 Recabar información<br/>pre-diagnóstico"]
B2 --> B24["2.4 Presentación de diagnóstico<br/>hallazgos y propuesta"]
B2 --> B25["2.5 Cierre de venta<br/>formalización del proyecto"]

%% BP 3 - project modules
B3 --> B31["3.1 Due Diligence Inmobiliario"]
B31 --> B31A["Propiedades · legal/fiscal · riesgos · recomendaciones"]

B3 --> B32["3.2 Due Diligence Corporativo Legal"]
B32 --> B32A["Estructura corporativa · contratos · cumplimiento · riesgos"]

B3 --> B33["3.3 Valuación de Empresas"]
B33 --> B33A["Análisis financiero · métodos de valuación · benchmarking"]

%% 3.4: handoff por eventos (ya no hay flujo copiado 3.4.1–3.4.7)
B3 --> B34["3.4 Planes de Protección<br/>(Seguros)"]
B34 --> H1["1. BP publica BPProtectionPlanRequested<br/>ClientID + ProyectoBPID"]
H1 --> H2["2. Ventas abre Oportunidad de Seguros en 2.6<br/>origen: ProyectoBPID"]
H2 --> H3["3. Seguros sigue su flujo normal 2.6 → 2.12<br/>clasificación BP → AF sin cambio"]
H3 --> H4["4. Pólizas publica PolicyActivated<br/>cierra 3.4 · arranca Customer Happiness"]

B3 --> B35["3.5 Protocolo Familiar"]
B35 --> B35A["Cuestionarios · información · acuerdos familiares · minutas"]

B3 --> B36["3.6 Fideicomisos"]
B36 --> B36A["Diseño · análisis legal/fiscal · implementación · seguimiento"]

B3 --> B37["3.7 Marco Legal"]
B37 --> B37A["Actas · documentos · organización · cumplimiento · actualización"]

B3 --> B38["3.8 Gobierno Corporativo"]
B38 --> B38A["Perfiles · pagos · evaluación · rotación · minutas"]

B3 --> B39["3.9 Family Office"]
B39 --> B39A["Activos · planeación patrimonial · coordinación · seguimiento"]

B3 --> B310["3.10 Consejero Independiente"]
B310 --> B310A["Perfil · selección · integración · seguimiento · rotación"]

%% BP 4 - intelligence
B4 --> B41["4.1 Análisis del entorno del cliente"]
B4 --> B42["4.2 Monitoreo de tendencias y riesgos"]
B4 --> B43["4.3 Competidores y referentes"]
B4 --> B44["4.4 Oportunidades de crecimiento y diversificación"]
B4 --> B45["4.5 Alertas y recomendaciones estratégicas"]
B4 --> B46["4.6 Reportes personalizados por cliente / familia"]
B4 --> B47["4.7 Integración con la estrategia del proyecto"]

%% BP 5 - operations (placeholder)
B5 --> B5A["Coordinación de módulos"]
B5 --> B5B["Seguimiento de entregables"]
B5 --> B5C["Control / avance del proyecto"]

%% BP 6 - administration (provisional hasta que la empresa defina atributos)
B6 --> B6A["Facturación y cobranza"]
B6 --> B6B["Minutas de tiempo cliente"]
B6 --> B6C["Control de horas"]
B6 --> B6D["Pago de aliados"]
B6 --> B6E["Pago de comisiones"]
B6 --> B6F["Pago a embajadores<br/>por definir: quién paga · BP / Seguros / ambos"]

%% ---------------------------------------------------------
%% ESSENTIAL CROSS-BUSINESS LINKS (solo eventos, vía Event Backbone)
%% ---------------------------------------------------------
B34 -.->|"BPProtectionPlanRequested"| BUS
BUS -.->|"Ventas consume → Oportunidad Seguros 2.6"| S26
S212 -.->|"PolicyActivated"| BUS
BUS -.->|"PolicyActivated → cierra 3.4"| B34
BUS -.->|"PolicyActivated / BPClosed → inicia CH"| CH
BUS -.->|"SaleClosed con origen embajador → pago"| B6F

%% =========================================================
%% SHARED SERVICES TREE
%% =========================================================
SHARED --> CLI["Clientes / Cliente 360"]
SHARED --> TAR["Tareas / Agendas"]
SHARED --> DOC["Documentos"]

CLI --> CLI1["Vista unificada del cliente"]
CLI --> CLI2["Relaciones con pólizas / siniestros / proyecto BP"]
TAR --> TAR1["Tareas · seguimiento · responsables · fechas"]
DOC --> DOC1["Repositorio / metadata / vínculos a entidades"]

%% =========================================================
%% SERVICIOS DE CLIENTE COMPARTIDOS (ambas líneas)
%% =========================================================
CLISVC --> CH["CUSTOMER HAPPINESS"]
CH --> CH1["1. Invitación a eventos"]
CH --> CH2["2. Aniversarios"]
CH --> CH3["3. Cumpleaños"]
CH --> CH4["4. Encuestas de satisfacción"]
CH --> CH5["5. Sesiones anuales de revisión"]
CH --> CH6["6. Comunicación de valor<br/>contenido / insights"]
CH --> CH7["7. Referidos y embajadores<br/>relación con embajadores · reconocimiento a los top"]

CLISVC --> PT["PORTAL DEL CLIENTE<br/>consumidor de read-models + canal · no es dominio"]
PT --> PT1["1. Registro y acceso<br/>login resuelve a ClientID"]
PT --> PT2["2. Visualización de pólizas"]
PT --> PT3["3. Estado de proyecto BP"]
PT --> PT4["4. Pagos y recibos"]
PT --> PT5["5. Solicitudes y servicios"]
PT --> PT6["6. Notificaciones y avisos"]
PT --> PT7["7. Soporte y ayuda<br/>contactar a mi asesor"]

BUS -.->|"read-models: pólizas · siniestros · pagos · docs · estado BP"| PT
PT1 -.->|"login → ClientID"| ID

%% =========================================================
%% MESSAGING TREE
%% =========================================================
MSG --> AUTO["Automation Rules<br/>'el robot'"]
MSG --> THR["Threads / Conversaciones<br/>bot ↔ humano / handoff"]
MSG --> INBOX["Advisor Inbox"]
MSG --> ADAPT["Channel Adapters<br/>(pluggable)"]

ADAPT --> WA["WhatsApp"]
ADAPT --> EM["Email"]
ADAPT --> MOCK["MockAdapter<br/>dev / test"]
ADAPT --> PADP["Portal<br/>se construye en ⑦"]
THR --> INBOX
THR -.->|"resolve channel handle → party"| ID
AUTO -.->|"consume / trigger events · handoff.requested"| BUS
THR -.->|"message.sent / message.received"| BUS
PT7 -.->|"contactar a mi asesor"| PADP

