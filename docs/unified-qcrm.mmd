%% =========================================================
%% CONEXIONES ENTRE UNIDADES
%% Handoff: BP 3.4 publica un evento; Seguros abre una
%% oportunidad nueva en 2.6, con origen en el ProyectoBPID.
%% No se comparte código ni se llama a Seguros directamente.
%% La clasificación del cliente (BP -> AF) NO cambia.
%% =========================================================

BP34 ==>|"Evento: BPProtectionPlanRequested"| S26

%% Retorno: la póliza activa cierra 3.4 y el cliente entra a Customer Happiness
S212 -.->|"Evento: PolicyActivated"| BP34
S212 -.->|"Cliente activo"| CH1
BP3 -.->|"Proyecto BP en curso / cerrado"| CH1

%% Portal: consumidor de lectura de ambas líneas (no es dominio)
S29 -.->|"lectura"| P2
BP3 -.->|"lectura"| P3