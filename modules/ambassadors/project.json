{
  "name": "ambassadors",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "modules/ambassadors/src",
  "projectType": "library",
  "tags": [
    "type:domain",
    "source:ambassadors",
    "layer:module"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "tsc -p modules/ambassadors/tsconfig.lib.json" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p modules/ambassadors/tsconfig.lib.json --noEmit" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/test-project.mjs ambassadors" }
    }
  }
}
