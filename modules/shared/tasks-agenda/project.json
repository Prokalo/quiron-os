{
  "name": "tasks-agenda",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "modules/shared/tasks-agenda/src",
  "projectType": "library",
  "tags": [
    "type:shared",
    "source:tasks-agenda",
    "layer:module"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "tsc -p modules/shared/tasks-agenda/tsconfig.lib.json" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p modules/shared/tasks-agenda/tsconfig.lib.json --noEmit" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/test-project.mjs tasks-agenda" }
    }
  }
}
