{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "targetDefaults": {
    "lint": {
      "cache": true
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/package-lock.json"
      ]
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/package-lock.json"
      ]
    },
    "test": {
      "cache": false,
      "dependsOn": ["build", "^build"],
      "inputs": ["default", "^default", "{workspaceRoot}/tools/**/*", "{workspaceRoot}/eslint.config.mjs"]
    }
  },
  "analytics": true
}
