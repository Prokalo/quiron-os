{
  "name": "event-envelope",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/event-envelope/src",
  "projectType": "library",
  "tags": ["type:shared", "source:event-envelope", "layer:infrastructure"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "tsc -p packages/event-envelope/tsconfig.lib.json" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p packages/event-envelope/tsconfig.lib.json --noEmit" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/test-project.mjs event-envelope" }
    }
  }
}
